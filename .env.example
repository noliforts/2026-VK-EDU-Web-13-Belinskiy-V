# Пример файла переменных окружения (скопируйте в .env.local или .env.docker)
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,web

# Настройки подключения к базе данных
DB_ENGINE=django.db.backends.postgresql
DB_NAME=qurilka_db
DB_USER=qurilka_user
DB_PASSWORD=qurilka_password
DB_HOST=localhost
DB_PORT=5432

# Переменные для сервиса PostgreSQL в docker-compose
POSTGRES_DB=qurilka_db
POSTGRES_USER=qurilka_user
POSTGRES_PASSWORD=qurilka_password
